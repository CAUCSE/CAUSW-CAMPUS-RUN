# Copy to server/.env (or inject these values through the deployment platform).
# Never commit server/.env or real production secrets.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/cau-typing.sqlite
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Generate separately for each environment:
# EMAIL_ENCRYPTION_KEY: openssl rand -base64 32
# STUDENT_NUMBER_HMAC_KEY and ADMIN_PASSWORD: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=<replace-with-32-byte-base64-key>
STUDENT_NUMBER_HMAC_KEY=<replace-with-32-byte-hmac-secret>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<replace-with-32-byte-admin-password>

# Production TLS and the public reverse proxy are operator-managed. Bind to a
# private interface unless a reviewed reverse-proxy/network policy requires otherwise.
